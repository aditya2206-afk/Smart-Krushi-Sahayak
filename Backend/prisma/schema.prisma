generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FARMER
  SELLER
  BUYER
  OFFICER
  ADMIN
}

enum QueryStatus {
  PENDING
  IN_REVIEW
  ANSWERED
  CLOSED
}

enum QueryPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProductCategory {
  VEGETABLE
  FRUIT
  GRAIN
  PULSE
  COMMERCIAL_CROP
  OTHER
}

enum ProductUnit {
  KG
  QUINTAL
  TON
  PIECE
}

enum ListingStatus {
  ACTIVE
  OUT_OF_STOCK
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  farmerProfile FarmerProfile?
  sellerProfile SellerProfile?
  buyerProfile  BuyerProfile?
  officerProfile OfficerProfile?

  farmerQueries   FarmerQuery[]    @relation("FarmerQueries")
  recommendations Recommendation[] @relation("OfficerRecommendations")
  produceListings ProduceListing[] @relation("SellerListings")
  buyerOrders     Order[]          @relation("BuyerOrders")
  sellerOrderItems OrderItem[]     @relation("SellerOrderItems")
}

model FarmerProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?
  village           String?
  district          String?
  state             String?
  preferredLanguage String?
  farmSize          String?
  mainCrops         String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SellerProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String?
  phone       String?
  address     String?
  district    String?
  state       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuyerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  address   String?
  district  String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficerProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  designation     String?
  qualification   String?
  specialization  String?
  department      String?
  experienceYears Int?
  officerId       String?
  district        String?
  state           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FarmerQuery {
  id          Int           @id @default(autoincrement())
  farmerId    Int
  farmer      User          @relation("FarmerQueries", fields: [farmerId], references: [id], onDelete: Cascade)
  title       String
  cropName    String
  category    String
  description String        @db.Text
  status      QueryStatus   @default(PENDING)
  priority    QueryPriority @default(MEDIUM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  answeredAt  DateTime?

  recommendation Recommendation?

  @@index([farmerId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Recommendation {
  id               Int         @id @default(autoincrement())
  queryId          Int         @unique
  query            FarmerQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  officerId        Int
  officer          User        @relation("OfficerRecommendations", fields: [officerId], references: [id], onDelete: Restrict)
  diagnosis        String      @db.Text
  recommendation   String      @db.Text
  fertilizerAdvice String?     @db.Text
  pesticideAdvice  String?     @db.Text
  additionalNotes  String?     @db.Text
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([officerId])
}

model ProduceListing {
  id          Int            @id @default(autoincrement())
  sellerId    Int
  seller      User           @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  category    ProductCategory
  grade       String?
  description String?        @db.Text
  quantity    Decimal        @db.Decimal(12, 2)
  unit        ProductUnit
  price       Decimal        @db.Decimal(12, 2)
  location    String
  imageUrl    String?
  status      ListingStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  orderItems OrderItem[]

  @@index([sellerId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([name])
}

model Order {
  id          Int         @id @default(autoincrement())
  buyerId     Int
  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  items OrderItem[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          Int            @id @default(autoincrement())
  orderId     Int
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     ProduceListing @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerId    Int
  seller      User           @relation("SellerOrderItems", fields: [sellerId], references: [id], onDelete: Restrict)
  productName String
  quantity    Decimal        @db.Decimal(12, 2)
  unit        ProductUnit
  unitPrice   Decimal        @db.Decimal(12, 2)
  subtotal    Decimal        @db.Decimal(12, 2)
  createdAt   DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

